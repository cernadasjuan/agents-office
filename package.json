{
  "name": "agents-office",
  "version": "1.1.0",
  "description": "3D office visualization of running Claude Code agents",
  "type": "module",
  "bin": {
    "agents-office": "bin/cli.mjs"
  },
  "files": [
    "LICENSE",
    "bin",
    "src",
    "server",
    "plugins",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "vite",
    "dev:fork": "AGENTS_OFFICE_PLUGINS=herdr,github,bmad,missions,library,peek,skills,floor-library,repos AGENTS_OFFICE_HERDR_FOCUS=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "measure": "tsx scripts/measure-scene.mts",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "3d",
    "threejs",
    "visualization"
  ],
  "author": "cernadasjuan",
  "license": "MIT",
  "dependencies": {
    "three": "^0.183.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.9.9",
    "@types/three": "^0.183.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
